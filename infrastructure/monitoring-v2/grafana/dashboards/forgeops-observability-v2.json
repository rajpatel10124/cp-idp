  "panels": [
    {
      "id": 1,
      "title": "cAdvisor Container CPU Utilization (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"$service.*|.*$service.*\"}[5m])) by (name) * 100 or sum(rate(process_cpu_seconds_total[5m])) * 100",
          "legendFormat": "{{name}} CPU %",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "cAdvisor Container Memory Usage (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(container_memory_usage_bytes{name=~\"$service.*|.*$service.*\"}) by (name) / 1024 / 1024 or sum(process_resident_memory_bytes) / 1024 / 1024",
          "legendFormat": "{{name}} Memory MB",
          "range": true,
          "refId": "A"
        }
      ]
    },
