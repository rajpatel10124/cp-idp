# ==============================================================================
# Internal Developer Platform (IDP) — Environment Variables Template
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# Application & Backend URLs
APP_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:7007
NODE_ENV=development

# GitHub Authentication & Integration
# Required for Scaffolder to publish scaffolded repositories to GitHub
GITHUB_TOKEN=ghp_YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET
GITHUB_ORG=your-github-org-or-username

# AWS Infrastructure & OIDC Deployment Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_OIDC_ROLE_ARN=arn:aws:iam::123456789012:role/idp-github-actions-oidc-role
ECR_REGISTRY_URL=123456789012.dkr.ecr.us-east-1.amazonaws.com

# PostgreSQL Production Database (Production Mode Only)
POSTGRES_HOST=idp-db.c123456789.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=idp_admin
POSTGRES_PASSWORD=SecurePasswordChangeMe123!
POSTGRES_DB=backstage_plugin_catalog

# TechDocs S3 Storage Bucket (Production Mode Only)
TECHDOCS_S3_BUCKET=idp-platform-techdocs-bucket-dev

# Kubernetes EKS Cluster
KUBERNETES_API_SERVER_URL=https://1234567890.gr7.us-east-1.eks.amazonaws.com
KUBERNETES_SA_TOKEN=eyJhbGciOiJSUzI1NiIs...
